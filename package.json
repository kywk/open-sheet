{
  "name": "open-sheet-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@open-sheet/demo",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "core": "pnpm --filter @open-sheet/core",
    "cli": "pnpm --filter @open-sheet/cli",
    "mcp": "pnpm --filter @open-sheet/mcp",
    "demo": "pnpm --filter @open-sheet/demo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "test:published": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@changesets/cli": "^3.0.0",
    "playwright": "^1.62.1",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    }
  }
}
