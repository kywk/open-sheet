{
  "name": "open-sheet-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@open-sheet/demo",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "core": "pnpm --filter @open-sheet/core",
    "cli": "pnpm --filter @open-sheet/cli",
    "mcp": "pnpm --filter @open-sheet/mcp",
    "demo": "pnpm --filter @open-sheet/demo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
